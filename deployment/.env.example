# Copy to deployment/.env. Values here are non-secret deployment configuration.
COMPOSE_PROJECT_NAME=solar-energy
POSTGRES_DB=solar_energy
POSTGRES_USER=solar_energy
# Loopback only. Change this for disposable tests if local PostgreSQL uses 5432.
POSTGRES_PORT=5432
# Add the actual VM hostname, LAN IP and (later) domain before LAN access.
# Hostnames/IPs only, comma-separated, without a URL scheme or port; never '*'.
ALLOWED_HOSTS=localhost,127.0.0.1
CONFIG_DIRECTORY=/opt/solar-energy/config
BACKUP_DIRECTORY=/opt/solar-energy/backups
POSTGRES_PASSWORD_FILE=/opt/solar-energy/secrets/postgres_password
JWT_SECRET_KEY_FILE=/opt/solar-energy/secrets/jwt_secret
LOG_LEVEL=INFO
BEVE_POLL_INTERVAL_SECONDS=30
TUYA_POLL_INTERVAL_SECONDS=10
TELEMETRY_PERSIST_INTERVAL_SECONDS=60
# APP_ENV=production, TZ=Africa/Lagos and empty CORS are fixed by Compose.
# Hardware credentials belong in the encrypted first-run wizard, never here.
