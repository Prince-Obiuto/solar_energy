# Copy to .env locally. Never commit production secrets.
APP_NAME=Smart Renewable Energy Management System
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://localhost/solar_energy
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=System Administrator
CORS_ORIGINS=http://localhost:5173
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_ENDPOINT=
TUYA_PROJECT_CODE=
BEVE_USERNAME=
BEVE_PASSWORD=
BEVE_APP_ID=
BEVE_APP_SECRET_ENCRYPTED=
BEVE_STATION_ID=
BEVE_DEVICE_ID=
BEVE_TIME_ZONE=Africa/Lagos
BEVE_TIMEOUT_SECONDS=30
BEVE_POLL_INTERVAL_SECONDS=30
TUYA_POLL_INTERVAL_SECONDS=10
TUYA_CONTROL_VERIFY_DELAY_SECONDS=0.5
TELEMETRY_PERSIST_INTERVAL_SECONDS=60
DEVICE_STALE_AFTER_SECONDS=90
TELEMETRY_RETRY_ATTEMPTS=2
TELEMETRY_RETRY_DELAY_SECONDS=1
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=20
WEBSOCKET_STALE_AFTER_SECONDS=60
