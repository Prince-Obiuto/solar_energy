# Copy to .env locally. Never commit production secrets.
APP_NAME=Smart Renewable Energy Management System
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://localhost/solar_energy
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=System Administrator
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=1048576
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
BEVE_USERNAME=
BEVE_PASSWORD=
BEVE_STATION_ID=
BEVE_DEVICE_ID=
BEVE_TIME_ZONE=Africa/Lagos
BEVE_TIMEOUT_SECONDS=30
BEVE_POLL_INTERVAL_SECONDS=30
TUYA_POLL_INTERVAL_SECONDS=10
TUYA_DEVICE_FILE=../devices.json
TUYA_SOCKET_TIMEOUT_SECONDS=5
TUYA_CONTROL_VERIFY_DELAY_SECONDS=0.5
TELEMETRY_PERSIST_INTERVAL_SECONDS=60
DEVICE_STALE_AFTER_SECONDS=90
TELEMETRY_RETRY_ATTEMPTS=2
TELEMETRY_RETRY_DELAY_SECONDS=1
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=20
WEBSOCKET_STALE_AFTER_SECONDS=60
HEALTH_MONITOR_INTERVAL_SECONDS=30
# Electrical alert thresholds are disabled unless explicitly configured.
ALERT_LOW_VOLTAGE_V=
ALERT_HIGH_VOLTAGE_V=
ALERT_HIGH_CURRENT_A=
ALERT_HIGH_POWER_W=
BACKUP_DESTINATION=backups
BACKUP_SECONDARY_DESTINATION=
BACKUP_RETENTION_DAYS=30
BACKUP_COMMAND=pg_dump
BACKUP_TIMEOUT_SECONDS=3600
