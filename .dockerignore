# Both Dockerfiles use this root context. Deny everything, then allow source.
**
!backend/
!backend/requirements.txt
!backend/alembic.ini
!backend/apps/
!backend/apps/**
!backend/migrations/
!backend/migrations/**
!backend/docker/
!backend/docker/entrypoint.py
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!deployment/
!deployment/nginx/
!deployment/nginx/default.conf
!energy/
!energy/siseli/
!energy/siseli/__init__.py
!energy/siseli/api.py
!energy/siseli/const.py
# Final denials also protect allowed source subdirectories.
**/.env
**/.env.*
**/__pycache__
**/*.pyc
**/devices.json
**/snapshot.json
**/tinytuya.json
**/tuya-raw.json
**/master.key
**/postgres_password
**/jwt_secret
**/*.runtime-key
**/*.pem
**/*.key
**/*.sqlite*
**/*.db
**/*.dump
**/*.sql
**/*.sql.gz
**/.git
**/.venv
**/node_modules
**/.pytest_cache
**/coverage
**/*.log
**/.coverage*
